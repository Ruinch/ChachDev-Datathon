# scripts/setup.ps1 creates .env with a generated key if the file is missing.
# Existing .env files are never overwritten. Process variables take precedence.
# Generate a unique key; never publish .env or the key.
APP_API_KEY=
APP_DATA_DIR=.local_data
APP_MAX_UPLOAD_MB=128
APP_MAX_VIDEO_SECONDS=180
APP_UPLOAD_TIMEOUT_SECONDS=30
APP_ANALYSIS_TIMEOUT_SECONDS=240
APP_FFPROBE_TIMEOUT_SECONDS=15
APP_FFMPEG_BIN=ffmpeg
APP_FFPROBE_BIN=ffprobe

# Launch scripts resolve relative data/rule/tool paths against the project root.
# Local .local_tools/ffmpeg/bin/*.exe are discovered for default tool names.

# Teammate 2 supplies an installed local module with a no-argument factory.
# Example shape: local_ml.adapter:create_analyzer
# Included experimental adapter: app.local_analyzer:build_analyzer
# Its model runs separately; see docs/ml-handoff.md. Candidate catalogs remain
# disabled until quality acceptance. Configuring this factory does not enable it.
APP_ANALYZER_FACTORY=

# Optional checked JSON catalog. Default app/data/rules.json has no enabled rules.
APP_RULE_CATALOG_PATH=

# Optional settings for the included adapter (requires prepared local runtime).
# APP_LOCAL_MODEL_URL=http://127.0.0.1:8091
# APP_ML_BUDGET_SECONDS=210
# APP_ML_FRAMES=12
# APP_ML_MAX_SIDE=848

# Set these after model files have been downloaded and verified locally.
# HF_HUB_OFFLINE=1
# TRANSFORMERS_OFFLINE=1
