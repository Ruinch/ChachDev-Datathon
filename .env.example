# Copy to .env. Existing process environment variables take precedence.
# Generate a unique key; never publish .env or the key.
APP_API_KEY=
APP_DATA_DIR=.local_data
APP_MAX_UPLOAD_MB=128
APP_MAX_VIDEO_SECONDS=180
APP_UPLOAD_TIMEOUT_SECONDS=30
APP_ANALYSIS_TIMEOUT_SECONDS=240
APP_FFPROBE_TIMEOUT_SECONDS=15
APP_FFMPEG_BIN=ffmpeg
APP_FFPROBE_BIN=ffprobe

# Teammate 2 supplies an installed local module with a no-argument factory.
# Example shape: local_ml.adapter:create_analyzer
APP_ANALYZER_FACTORY=

# Optional checked JSON catalog. Default app/data/rules.json has no enabled rules.
APP_RULE_CATALOG_PATH=

# Set these after model files have been downloaded and verified locally.
# HF_HUB_OFFLINE=1
# TRANSFORMERS_OFFLINE=1
